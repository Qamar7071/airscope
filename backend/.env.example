# AirScope backend configuration. Copy to backend/.env and edit as needed.
# All values are optional; the defaults run the fully offline demo.

# demo = bundled synthetic data (default, offline) | live/auto = OpenAQ + Open-Meteo when a key is set
AIRSCOPE_DATA_MODE=demo
# Free OpenAQ v3 key (https://explore.openaq.org/register). Only needed for live mode.
OPENAQ_API_KEY=
# Days of history fetched in live mode (2-90) and how long live responses are cached
AIRSCOPE_LIVE_HISTORY_DAYS=14
AIRSCOPE_LIVE_CACHE_TTL_HOURS=1

# Model training: full (with OSSE benchmark, ~1 min/city) or fast (~10 s/city)
AIRSCOPE_TRAINING_PROFILE=full
AIRSCOPE_TRAIN_ON_STARTUP=true
AIRSCOPE_RANDOM_SEED=42

# Server
AIRSCOPE_HOST=127.0.0.1
AIRSCOPE_PORT=8000
AIRSCOPE_CORS_ORIGINS=*
AIRSCOPE_LOG_LEVEL=INFO
